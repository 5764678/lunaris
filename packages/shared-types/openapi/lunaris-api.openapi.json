  "info": {
    "description": "LUNARIS — Lunar Mission Intelligence & Surface Operations Platform.\n\nMilestone 01 API: service health, scientific toolchain report, dataset registry with\nlocal provenance status, and a registry of user-defined candidate sites.\n\nConventions: snake_case fields; units as suffixes (`_deg`, `_m`, `_s`, `_bytes`);\ntimestamps ISO 8601 UTC; coordinates planetocentric in the MOON_ME frame with east\nlongitude in [0, 360). Every non-2xx response uses the `ErrorResponse` envelope.\n\nLUNARIS is a preliminary mission-planning and research tool, not a certified\nspacecraft landing system.",
    "summary": "Lunar Mission Intelligence & Surface Operations Platform",
    "title": "LUNARIS API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/datasets": {
      "get": {
        "description": "Every dataset LUNARIS knows about, with provenance metadata, URL verification\nstatus and whether it is present in the local data store. Status is computed from\nfile presence and sizes; full checksum verification is done with\n``lunaris-data verify``.",
        "operationId": "list_datasets_api_v1_datasets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unexpected server error."
          }
        },
        "summary": "Registered datasets and their local acquisition status",
        "tags": [
          "datasets"
        ]
      }
    },
    "/api/v1/datasets/{dataset_id}": {
      "get": {
        "operationId": "get_dataset_api_v1_datasets__dataset_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "dataset_id",
            "required": true,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{2,63}$",
              "title": "Dataset Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DatasetSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unknown dataset."
          },
          "422": {
            "content": {
              "application/json": {
