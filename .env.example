# ─────────────────────────────────────────────────────────────────────────────
# LUNARIS configuration template. Copy to `.env` (repository root) and adjust.
# `.env` is git-ignored. Never commit secrets. M01 needs no secrets at all.
# All paths are resolved relative to the directory the process is started from
# (the repository root when using the documented npm/uv commands).
# ─────────────────────────────────────────────────────────────────────────────

# ── API (FastAPI, read by apps/api via pydantic-settings, prefix LUNARIS_) ──
# development | test | production
LUNARIS_ENVIRONMENT=development
LUNARIS_LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed by CORS.
LUNARIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Root of the local scientific data store (raw/, processed/, kernels/, state/).
LUNARIS_DATA_DIR=./data
# SQLAlchemy database URL. Defaults to SQLite at <LUNARIS_DATA_DIR>/state/lunaris.sqlite3
# LUNARIS_DATABASE_URL=sqlite:///./data/state/lunaris.sqlite3
# Serve interactive OpenAPI docs at /docs and /redoc.
LUNARIS_DOCS_ENABLED=true
# Public demo only: answer 403 when someone deletes one of the cited (published) sites, so a
# visitor cannot remove the demo sites. Leave off locally.
# LUNARIS_PROTECT_PUBLISHED_SITES=true

# ── Web (Next.js). NEXT_PUBLIC_* values are inlined into the browser bundle at
#    build time — never put secrets in them. Put web overrides in apps/web/.env.local.
NEXT_PUBLIC_LUNARIS_API_URL=http://localhost:8000
